{
  "name": "Trip Safety Monitor",
  "description": "Automatically evaluates trip safety_data against thresholds and creates SafetyAlert records for flagged trips",
  "trigger": {
    "condition": "${ (.trigger.data.safety_data != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "Trip"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "trip_safety_monitor",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "checkTripSafety",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "checkTripSafety"
  }
}